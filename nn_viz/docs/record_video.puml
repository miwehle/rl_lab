@startuml

!include ../../puml_links.iuml

title NN Viz Live Video Overlay - Core Call Chain

hide footbox

participant "micro_elise_nn_video.ipynb" as Notebook
participant "nn_viz.video" as Video
participant "_NetworkOverlayWrapper" as Wrapper
participant "_render_live_layout_rgba" as LiveRender

url of Notebook is [[WORKSPACE_ROOT/nn_viz/notebooks/micro_elise_nn_video.ipynb]]
url of Video is [[WORKSPACE_ROOT/nn_viz/src/nn_viz/video.py:1:1]]
url of Wrapper is [[WORKSPACE_ROOT/nn_viz/src/nn_viz/video.py:733:1]]
url of LiveRender is [[WORKSPACE_ROOT/nn_viz/src/nn_viz/video.py:233:1]]

Notebook -> Video : [[WORKSPACE_ROOT/nn_viz/src/nn_viz/video.py:33:1 record_video(...)]]
activate Video

Video -> Wrapper : create wrapper with overlay_provider\n[[WORKSPACE_ROOT/nn_viz/src/nn_viz/video.py:71:1 _NetworkOverlayWrapper(...)]]

loop video frames
    Wrapper -> Wrapper : render()
    Wrapper -> LiveRender : [[WORKSPACE_ROOT/nn_viz/src/nn_viz/video.py:233:1 _render_live_layout_rgba(...)]]
    LiveRender --> Wrapper : NN RGBA image
    Wrapper -> Wrapper : _compose_bottom_overlay(...)\n[[WORKSPACE_ROOT/nn_viz/src/nn_viz/video.py:783:1 _compose_bottom_overlay(...)]]
end

Video --> Notebook : MP4 path
deactivate Video

@enduml

